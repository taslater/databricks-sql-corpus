// Databricks-only statements, injected into the `statement` rule.
//
// Syntax follows the Databricks SQL language reference. Where Databricks
// accepts more than one spelling we take the documented one plus any variant
// seen in real code; where it is stricter than we can check statically (for
// example, that ZORDER columns actually exist) we parse permissively and
// leave the semantic check to a lint rule.
//
// Every alternative carries a #label so the generated visitor gets a named
// context for lint rules to hang off.

    | OPTIMIZE table=identifierReference FULL?
        (WHERE where=booleanExpression)?
        (ZORDER BY zorder=zorderColumnList)?                           #optimizeTable
    | VACUUM (table=identifierReference | path=stringLit)
        (LITE | FULL)?
        (RETAIN retainHours=number HOURS)?
        (DRY RUN)?                                                     #vacuumTable
    | COPY INTO target=identifierReference
        (LEFT_PAREN targetCols=multipartIdentifierList RIGHT_PAREN)?
        FROM source=copyIntoSource
        (FILEFORMAT EQ fileFormatName=identifier)?
        (VALIDATE (ALL | validateRows=number ROWS)?)?
        (FILES EQ files=stringLitList)?
        (PATTERN EQ pattern=stringLit)?
        (FORMAT_OPTIONS formatOptions=propertyList)?
        (COPY_OPTIONS copyOptions=propertyList)?                       #copyInto
    | CREATE (OR REFRESH)? TEMPORARY? PRIVATE? (STREAMING LIVE? | LIVE)
        (TABLE | VIEW)
        (IF errorCapturingNot EXISTS)? identifierReference
        (LEFT_PAREN colDefinitionList RIGHT_PAREN)?
        tableProvider?
        createTableClauses
        (SCHEDULE schedule=scheduleSpec)?
        (AS? query)?                                                   #createStreamingTable
    | CREATE (OR (REPLACE | REFRESH))? MATERIALIZED VIEW
        (IF errorCapturingNot EXISTS)? identifierReference
        (LEFT_PAREN colDefinitionList RIGHT_PAREN)?
        tableProvider?
        createTableClauses
        (SCHEDULE schedule=scheduleSpec)?
        AS query                                                       #createMaterializedView
    | REFRESH MATERIALIZED VIEW identifierReference                    #refreshMaterializedView
    | REFRESH STREAMING TABLE identifierReference FULL?                #refreshStreamingTable
    | CREATE EXTERNAL? VOLUME (IF errorCapturingNot EXISTS)? identifierReference
        locationSpec? commentSpec?                                     #createVolume
    | DROP VOLUME (IF EXISTS)? identifierReference                     #dropVolume
    | CREATE CATALOG (IF errorCapturingNot EXISTS)? identifierReference
        (USING SHARE share=identifierReference)?
        (MANAGED LOCATION managedLocation=stringLit)?
        commentSpec?
        (WITH (DBPROPERTIES | PROPERTIES) propertyList)?               #createCatalog
    | DROP CATALOG (IF EXISTS)? identifierReference
        (RESTRICT | CASCADE)?                                          #dropCatalog
    | RESTORE TABLE? identifierReference TO temporalClause             #restoreTable
    | ALTER tagTarget identifierReference SET TAGS propertyList        #setTags
    | ALTER tagTarget identifierReference UNSET TAGS propertyList      #unsetTags
    | createTableHeader (SHALLOW | DEEP) CLONE
        source=identifierReference temporalClause?
        createTableClauses                                             #createTableClone
    | replaceTableHeader (SHALLOW | DEEP) CLONE
        source=identifierReference temporalClause?
        createTableClauses                                             #replaceTableClone
    | ALTER TABLE identifierReference
        ADD CONSTRAINT name=errorCapturingIdentifier
        constraintDefinition                                           #alterTableAddConstraint
    | ALTER TABLE identifierReference
        DROP CONSTRAINT (IF EXISTS)? name=errorCapturingIdentifier
        (RESTRICT | CASCADE)?                                          #alterTableDropConstraint

    // --- Notebook widgets ---------------------------------------------------
    // Widget DDL opens most parameterised notebooks, so failing to parse it
    // takes down every statement after it too.
    | CREATE WIDGET widgetType
        name=errorCapturingIdentifier
        DEFAULT defaultValue=expression
        (CHOICES widgetChoices)?                                        #createWidget
    | REMOVE WIDGET name=errorCapturingIdentifier                       #removeWidget

    // --- Unity Catalog governance ------------------------------------------
    // Spark only has `SHOW GRANT` (singular) inside its
    // unsupportedHiveNativeCommands catch-all, so `SHOW GRANTS ON x` is read
    // as `SHOW <identifier> FUNCTIONS` and fails on the missing FUNCTIONS.
    | SHOW GRANTS (principal=errorCapturingIdentifier)?
        ON securable=securableObject                                    #showGrants
    | USE CATALOG identifierReference                                   #useCatalog
    | ALTER ownerTarget identifierReference
        SET? OWNER TO principal=errorCapturingIdentifier                #setOwner
    | COMMENT ON COLUMN multipartIdentifier IS comment                  #commentOnColumn
    | CREATE CONNECTION (IF errorCapturingNot EXISTS)? identifierReference
        TYPE connectionType=identifier
        (OPTIONS options=propertyList)?
        commentSpec?                                                    #createConnection
    | DROP CONNECTION (IF EXISTS)? identifierReference                  #dropConnection
    | CREATE EXTERNAL LOCATION (IF errorCapturingNot EXISTS)? identifierReference
        URL url=stringLit
        WITH LEFT_PAREN STORAGE CREDENTIAL credential=identifierReference RIGHT_PAREN
        commentSpec?                                                    #createExternalLocation
    | DROP EXTERNAL LOCATION (IF EXISTS)? identifierReference           #dropExternalLocation
    | CREATE STORAGE CREDENTIAL (IF errorCapturingNot EXISTS)? identifierReference
        WITH credentialSpec
        commentSpec?                                                    #createStorageCredential
    | DROP STORAGE CREDENTIAL (IF EXISTS)? identifierReference          #dropStorageCredential
    | CREATE SHARE (IF errorCapturingNot EXISTS)? identifierReference
        commentSpec?                                                    #createShare
    | DROP SHARE (IF EXISTS)? identifierReference                       #dropShare
    | ALTER SHARE identifierReference
        (ADD | REMOVE) shareObject identifierReference
        (COMMENT shareComment=stringLit)?
        (AS alias=identifierReference)?                                 #alterShare
    | CREATE RECIPIENT (IF errorCapturingNot EXISTS)? identifierReference
        (USING ID recipientId=stringLit)?
        commentSpec?
        (PROPERTIES propertyList)?                                      #createRecipient
    | DROP RECIPIENT (IF EXISTS)? identifierReference                   #dropRecipient

    // --- Row filters and column masks --------------------------------------
    | ALTER TABLE identifierReference
        SET ROW FILTER function=identifierReference
        ON LEFT_PAREN (multipartIdentifierList)? RIGHT_PAREN            #setRowFilter
    | ALTER TABLE identifierReference DROP ROW FILTER                   #dropRowFilter
    | ALTER TABLE identifierReference
        ALTER COLUMN column=multipartIdentifier
        SET MASK function=identifierReference
        (USING COLUMNS LEFT_PAREN multipartIdentifierList RIGHT_PAREN)? #setColumnMask
    | ALTER TABLE identifierReference
        ALTER COLUMN column=multipartIdentifier DROP MASK               #dropColumnMask

    // --- Maintenance --------------------------------------------------------
    | ALTER predictiveTarget identifierReference
        (ENABLE | DISABLE | INHERIT) PREDICTIVE OPTIMIZATION            #predictiveOptimization
    | SYNC (SCHEMA | TABLE) target=identifierReference
        FROM source=identifierReference
        (SET OWNER principal=errorCapturingIdentifier)?                 #syncObject
    | CACHE LAZY? query                                                 #cacheSelect
    | SHOW VOLUMES ((FROM | IN) identifierReference)?
        (LIKE? pattern=stringLit)?                                      #showVolumes
    | SHOW SHARES (LIKE? pattern=stringLit)?                            #showShares
    | SHOW RECIPIENTS (LIKE? pattern=stringLit)?                        #showRecipients
    | SHOW PROVIDERS (LIKE? pattern=stringLit)?                         #showProviders
    | SHOW CONNECTIONS (LIKE? pattern=stringLit)?                       #showConnections

    // --- Delta table utilities ----------------------------------------------
    | CONVERT TO DELTA identifierReference
        (errorCapturingNot? STATISTICS)?
        (PARTITIONED BY partitionFieldList)?                            #convertToDelta
    | FSCK REPAIR TABLE identifierReference (DRY RUN)?                  #fsckRepairTable
    | GENERATE generateMode=identifier FOR TABLE identifierReference            #generateManifest
    | REORG TABLE identifierReference
        (WHERE where=booleanExpression)?
        APPLY LEFT_PAREN reorgAction RIGHT_PAREN                        #reorgTable
    | ALTER TABLE identifierReference
        DROP FEATURE feature=identifier
        (TRUNCATE HISTORY)?                                             #dropTableFeature
    | LIST path=stringLit                                               #listVolumePath

    // --- Lakeflow declarative pipelines --------------------------------------
    | APPLY CHANGES INTO target=identifierReference
        FROM source=relationPrimary
        KEYS LEFT_PAREN keys=multipartIdentifierList RIGHT_PAREN
        (IGNORE NULL UPDATES)?
        (APPLY AS DELETE WHEN deleteWhen=booleanExpression)?
        (APPLY AS TRUNCATE WHEN truncateWhen=booleanExpression)?
        SEQUENCE BY sequenceBy=multipartIdentifier
        (COLUMNS columns=applyChangesColumns)?
        (STORED AS SCD TYPE scdType=number)?
        (TRACK HISTORY ON trackHistory=applyChangesColumns)?            #applyChangesInto
    | CREATE FLOW identifierReference
        commentSpec?
        AS statement                                                    #createFlow

    // --- Principals ----------------------------------------------------------
    | SHOW GROUPS (WITH USER identifierReference)?                      #showGroups
    | SHOW USERS                                                        #showUsers
    | DENY privilegeList ON securableObject TO principal=errorCapturingIdentifier #denyPrivileges
